# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full DSN used by db.py to open a connection pool.
# Local Docker stack: postgresql://rocketdash:changeme@localhost:5432/rocketdash
# Render internal:    postgresql://user:pass@host-a/dbname
POSTGRES_DSN=postgresql://rocketdash:changeme@localhost:5432/rocketdash

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Filesystem path where ChromaDB persists its vector store.
# Must be writable by the process running the MCP server.
CHROMA_PATH=./chroma_data
